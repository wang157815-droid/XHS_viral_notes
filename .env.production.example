# RedMuse ECS 生产环境变量模板
# 使用方式：
#   cp .env.production.example .env
#   修改下面的占位值后再执行 docker compose up -d --build ...

# ============================
# 基础运行模式
# ============================
PRODUCTION=true
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Next.js 前端构建期 API 地址。
# 当前 Nginx 同源反代方案必须使用 /api/v1，避免浏览器访问用户本机 localhost。
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ============================
# 认证配置（必填）
# ============================
# 生成方法：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
REDMUSE_JWT_SECRET=replace-with-a-random-64-hex-secret

# ============================
# Phase 0：RedMuse 首启动 admin 引导（必填一次）
# ============================
# 仅当 datas/redmuse_auth/users.json 不存在/为空时生效；首启动后建议立即修改密码。
REDMUSE_BOOTSTRAP_ADMIN_USER=admin
REDMUSE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
REDMUSE_BOOTSTRAP_ADMIN_NICKNAME=管理员
# 把已扫码生成的 datas/users/admin/cookies.json 自动挂到新 admin（如果存在）
REDMUSE_BOOTSTRAP_XHS_CREDENTIAL_PATH=datas/users/admin/cookies.json

# ============================
# PostgreSQL（必填）
# ============================
# 首次初始化后不要随意修改 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB，
# 否则已有 volume 中的数据库账号不会自动同步变更。
POSTGRES_USER=redmuse
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=redmuse

# Redis / 事件流 / 任务运行
BACKLOG_BACKEND=redis
TASK_RUNNER=inprocess

# ============================
# 小红书登录与采集
# ============================
# 多用户系统下请勿在此填写 Cookie，每位用户须在「设置 → 数据源授权」单独绑定小红书账号。
# 填写此处的全局 Cookie 会被系统拒绝用于已注册的 u_* 用户，防止账号共享。
# 单机/遗留场景（无注册用户）才可在此填写。
# COOKIE=
# 国内站默认：
# XHS_LOGIN_START_URL=https://www.xiaohongshu.com/explore
# 国际站 RedNote 可按需开启：
# XHS_LOGIN_START_URL=https://www.rednote.com/explore
# XHS_INTERNATIONAL=true
# XHS_API_BASE_URL=https://webapi.rednote.com
# XHS_WEB_ORIGIN=https://www.rednote.com
XHS_LOGIN_CLOSE_DELAY_SEC=5

# ============================
# 文本模型（至少配置一组，爆文模型和对话问答会用到）
# ============================
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=replace-with-your-deepseek-key
MODEL_NAME=deepseek-chat

# 如果只修改 .env 不重启容器，可设 true；Docker 部署通常建议重启容器。
LLM_RELOAD_DOTENV=false

# ============================
# Embedding / RAG 知识库
# ============================
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v4

# ============================
# 多模态 / 视频分析（可选，但图文/视频深度分析建议配置）
# ============================
MULTIMODAL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_API_KEY=replace-with-your-dashscope-key
MULTIMODAL_MODEL_NAME=qwen3-vl-plus
VIDEO_MODEL_NAME=qwen3-vl-plus
VIDEO_ANALYSIS_MODE=full
VIDEO_SOURCE_MODE=url
VIDEO_MAX_CONCURRENT=2
VIDEO_AI_MAX_CONCURRENT=2
VIDEO_DOWNLOAD_TIMEOUT=60
VIDEO_MAX_SIZE_MB=100

# 音画同步默认关闭，首版 ECS 部署建议跑通基础链路后再开启。
ENABLE_AV_SYNC=false
ENABLE_FRAME_ASR_ANALYSIS=false
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
FRAME_INTERVAL=5.0
MAX_FRAMES_PER_VIDEO=20
CLEANUP_TEMP_FILES=true

# OCR 默认用多模态模型；未配置多模态 Key 时系统会自动降级。
OCR_MODE=ai

# 编排引擎
ORCHESTRATION_ENGINE=simple
