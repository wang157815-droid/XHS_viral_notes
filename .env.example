MINIMAX_SYSTEM_PROMPT="����һ��רҵ��С����������Ӫ���֣��ó����ķ��������ݲ߻��ʹ������顣���ü���Ѻõ����Ļش��û����⡣"

# ============================
# 企业微信会话内容存档
# ============================
# 管理后台「管理工具 → 聊天内容存档」里的专用 Secret（与应用 Secret 不同）
WXWORK_FINANCE_SECRET="your_finance_secret_here"

# 官方 C++ SDK .so 文件路径（Linux 服务器上的路径）
# 下载地址：企微开发者中心 → 会话内容存档 → SDK 下载（x86 v2.0 或 v3.0）
# 下载后放到服务器，并在 docker-compose.yml 中挂载到容器
WXWORK_FINANCE_SDK_PATH="/app/WeWorkFinanceSdk_C.so"

# RSA 私钥文件路径（服务器上 wxwork_private_key.pem 的绝对路径）
WXWORK_RSA_PRIVATE_KEY_PATH="/app/wxwork_private_key.pem"

# 或者直接把私钥内容粘贴进来（换行用 \n 替代，与 _PATH 二选一）
# WXWORK_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
