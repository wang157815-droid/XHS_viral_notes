# ============================
# 小红书爬虫配置
# ============================

# 必填：小红书Cookie（从浏览器开发者工具获取）
COOKIE="a1=xxx; web_session=xxx; webId=xxx"

# ============================
# 认证配置（必填 - 用于Web API安全）
# ============================
# JWT 认证密钥（缺失时应用拒绝启动）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="your-jwt-secret-here-replace-with-random-value"
# 等价别名（任意一个即可，REDMUSE_JWT_SECRET 优先级更高，便于多环境覆盖）
# REDMUSE_JWT_SECRET="your-jwt-secret-here-replace-with-random-value"

# ============================
# Phase 0：RedMuse 首启动 admin 引导（用户名/密码登录）
# ============================
# 仅当 datas/redmuse_auth/users.json 不存在/为空时生效；已有用户则跳过。
# 第一次启动后请立即用 admin 登录系统，然后在「设置 → 用户管理」中再修改。
REDMUSE_BOOTSTRAP_ADMIN_USER=admin
REDMUSE_BOOTSTRAP_ADMIN_PASSWORD=please-change-me-on-first-login
REDMUSE_BOOTSTRAP_ADMIN_NICKNAME=管理员
# 把现有 datas/users/admin/cookies.json 直接挂到新 admin，避免重新扫码（可改）
REDMUSE_BOOTSTRAP_XHS_CREDENTIAL_PATH=datas/users/admin/cookies.json

# ============================
# Phase 3：虚拟手机号 / SMS 自动登录（hero-sms）
# ============================
# 仅启用「自动 SMS 重新授权」入口时需要；不配置时该入口在前端显示为禁用。
# 申请页：https://hero-sms.com（注册后获取 api_key）
SMS_PROVIDER_API_KEY=
# 默认值已对齐用户给定的 hero-sms 固定参数；切换运营商或国家时再覆盖。
# SMS_PROVIDER_BASE_URL=https://hero-sms.com/stubs/handler_api.php
# SMS_PROVIDER_SERVICE=qf
# SMS_PROVIDER_COUNTRY=14
# SMS_PROVIDER_MAX_PRICE=1

# Playwright 扫码登录：默认打开 https://www.xiaohongshu.com/explore
# 海外/国际版 RedNote 若在国内站无法完成闭环，可改为 RedNote 首页或发现页，例如：
# XHS_LOGIN_START_URL="https://www.rednote.com/explore"
# （具体以浏览器可打开的官方登录页为准，也可试 https://www.rednote.com/）。当 URL 含 rednote.com 时，
# 会自动按 MediaCrawler 规则使用 API 基址 https://webapi.rednote.com 与 Origin https://www.rednote.com，
# 否则用 edith 校验 Cookie 会一直失败、无法进入「登录成功」。
# 若爬取/校验仅针对国际站但登录 URL 未设 rednote，可显式打开：
# XHS_INTERNATIONAL=true
# XHS_API_BASE_URL="https://webapi.rednote.com"
# XHS_WEB_ORIGIN="https://www.rednote.com"
# 登录成功后自动关闭浏览器前的等待秒数（默认 5，最大 60；原 30 秒易误以为卡住）
# XHS_LOGIN_CLOSE_DELAY_SEC=5

# ============================
# AI分析配置（可选）
# ============================
# 如果不配置，将跳过AI深度分析功能

# 方案1：DeepSeek（推荐 - 高性价比，仅文本分析）
# 成本：约0.16元/100篇笔记分析
# 申请地址：https://platform.deepseek.com/
OPENAI_API_BASE="https://api.deepseek.com/v1"
OPENAI_API_KEY="sk-deepseek-your-api-key-here"
MODEL_NAME="deepseek-chat"

# 改密钥后不想重启进程：设为 true 时，每次模型请求前会 load_dotenv(override=True) 再读密钥
# （仅改 .env 文件、未 export 到当前 shell 时尤其需要；也可用 DOTENV_PATH 指定文件路径）
# LLM_RELOAD_DOTENV=true
# DOTENV_PATH="E:/path/to/.env"

# 产品分析专用模型（可选 - 独立配置）
# 产品分析需要稳定的输出格式，推荐使用 deepseek-chat
# 如果 MODEL_NAME 使用 deepseek-reasoner（推理能力强但有时返回空响应），
# 可以单独配置此项让产品分析使用更稳定的模型
# PRODUCT_MODEL_NAME="deepseek-chat"

# 标题分类专用模型（可选 - 独立配置）
# 标题分类需要快速响应和固定格式输出，推荐使用 deepseek-chat
# 避免使用 deepseek-reasoner 等推理模型（可能返回长思考链或空响应）
# TITLE_MODEL_NAME="deepseek-chat"

# ============================
# RAG知识库配置（可选 - 用于文档向量化）
# ============================
# 用于上传的文档进行语义检索，建议使用小模型降低成本

# 方案1：单独配置Embedding API（推荐，可使用不同的API服务商）
# 阿里云text-embedding-v4（性价比高）
EMBEDDING_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_API_KEY="sk-your-dashscope-api-key"
EMBEDDING_MODEL="text-embedding-v4"
# 成本：约0.0007元/1000次调用

# 方案2：共用主模型API（如果主模型也用阿里云）
# 注释掉上面的EMBEDDING_API_*配置，系统会自动使用OPENAI_API_*
# EMBEDDING_MODEL="text-embedding-v4"

# 方案3：OpenAI Embedding（需要OpenAI API或镜像）
# EMBEDDING_API_BASE="https://api.openai.com/v1"
# EMBEDDING_API_KEY="sk-your-openai-api-key"
# EMBEDDING_MODEL="text-embedding-3-small"

# 方案4：本地Embedding模型（完全免费，离线可用）
# USE_LOCAL_EMBEDDING=true
# LOCAL_EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"
# 需安装：pip install sentence-transformers

# ============================
# 多模态AI分析配置（可选 - 用于图片+文字联合分析 & 视频AI深度分析）
# ============================
# 如果需要分析图片内容与文字的配合关系，或进行视频AI深度分析，请配置以下参数
# 注意：视频AI深度分析需要支持视频的模型（如GLM-4V-Plus、Qwen-VL-Max）

# 多模态方案1（推荐）：通义千问 Qwen3-VL（阿里云 - 最新视觉理解模型）
# 功能：✅ 图文分析 ✅ 视频AI深度分析 ✅ 智能体交互能力
# 相比旧版本，Qwen3-VL 在视觉理解、GUI识别方面有显著提升
# 申请地址：https://dashscope.console.aliyun.com/
# MULTIMODAL_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# MULTIMODAL_API_KEY="sk-your-qwen-api-key-here"
# MULTIMODAL_MODEL_NAME="qwen3-vl-plus"
# VIDEO_MODEL_NAME="qwen3-vl-plus"
# VIDEO_ANALYSIS_MODE="full"  # full=完整视频分析，metadata=仅元数据分析

# 视频源处理配置（解决小红书CDN Referer防盗链问题）
# url: 直接使用原始URL（默认，适合国内模型API如阿里云）
# proxy: 本地下载视频（带Referer头）后转base64传给模型（适合模型方无法访问小红书CDN的情况）
# VIDEO_SOURCE_MODE="url"

# 爆文流水线：图文/视频 6 要素标注条数(与 Excel 四源样本行对齐;可见样本优先)
# IMAGE_ANALYSIS_TOP_N="6"
# IMAGE_ANALYSIS_HARD_MAX="80"
# VIDEO_ANALYSIS_MAX_COUNT="30"
# VIDEO_ANALYSIS_HARD_MAX="80"

# 爬虫四源视图：SERP 回退切片偏移 / 竞品评论热词(首屏评论+jieba 分词,最多 N 条笔记调评论 API)
# CRAWLER_SERP_FALLBACK_OFFSET="5"
# 竞品 Sheet4「评论热词 Top10」：逐条拉首屏评论后分词，非 LLM；为控接口压力默认只处理互动 Top N 条，超出部分 U 列为空。
# CRAWLER_COMPETITOR_COMMENT_HOTWORDS="true"
# CRAWLER_COMPETITOR_COMMENT_MAX_NOTES="50"

# 视频下载并发限制（避免API限流和超时）
# VIDEO_MAX_CONCURRENT="2"

# 视频AI深度分析并发数（内容+产品分析并行执行）
# - 云端CPU弱：设为2
# - 普通配置：设为3（默认）
# - 高配置：设为4-5
# VIDEO_AI_MAX_CONCURRENT="3"

# 视频下载超时（秒，proxy模式专用）
# VIDEO_DOWNLOAD_TIMEOUT="60"

# 单个视频大小限制（MB）
# 此配置主要用于 AVSync 音画同步分析场景
# - AVSync：可处理最大 200MB 视频（本地 ffmpeg 处理，不受 API 限制）
# - AI 分析：自动限制在 7MB 内（base64 膨胀后约 10MB，符合 API 限制）
# 超过 AI 限制的视频会自动降级到 URL 模式（不下载，直接传 URL 给 AI）
VIDEO_MAX_SIZE_MB="100"

# 多模态方案2：智谱GLM-4V-Plus（支持视频URL直接分析）
# 功能：✅ 图文分析 ✅ 视频AI深度分析（无需下载视频）
# 成本：图片约0.5元/100张，视频约0.5元/100个
# 申请地址：https://open.bigmodel.cn/
# MULTIMODAL_API_BASE="https://open.bigmodel.cn/api/paas/v4"
# MULTIMODAL_API_KEY="your-glm-api-key-here"
# MULTIMODAL_MODEL_NAME="glm-4v-plus"
# VIDEO_MODEL_NAME="glm-4v-plus"
# VIDEO_ANALYSIS_MODE="full"

# 多模态方案3：通义千问VL-Max（阿里云 - 稳定版本）
# 功能：✅ 图文分析 ✅ 视频AI深度分析
# 成本：图片约0.5元/100张，视频约1元/100个
# 申请地址：https://dashscope.console.aliyun.com/
# MULTIMODAL_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# MULTIMODAL_API_KEY="sk-your-qwen-api-key-here"
# MULTIMODAL_MODEL_NAME="qwen-vl-max"
# VIDEO_MODEL_NAME="qwen-vl-max"
# VIDEO_ANALYSIS_MODE="full"

# 多模态方案4：智谱GLM-4V基础版（完全免费 - 仅支持图文分析）
# 功能：✅ 图文分析 ❌ 不支持视频深度分析
# 成本：0元
# 申请地址：https://open.bigmodel.cn/
# MULTIMODAL_API_BASE="https://open.bigmodel.cn/api/paas/v4"
# MULTIMODAL_API_KEY="your-glm-api-key-here"
# MULTIMODAL_MODEL_NAME="glm-4v"

# 方案2：通义千问（中文理解最强）
# 成本：约0.26元/100篇笔记分析
# 申请地址：https://dashscope.console.aliyun.com/
# OPENAI_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# OPENAI_API_KEY="sk-your-qwen-api-key-here"
# MODEL_NAME="qwen-max"

# 方案3：智谱GLM（完全免费）
# 成本：0元（glm-4-flash模型永久免费）
# 申请地址：https://open.bigmodel.cn/
# OPENAI_API_BASE="https://open.bigmodel.cn/api/paas/v4"
# OPENAI_API_KEY="your-glm-api-key-here"
# MODEL_NAME="glm-4-flash"

# 方案4：OpenAI GPT-4（原版）
# 成本：约3.75元/100篇笔记分析
# OPENAI_API_BASE="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-your-openai-api-key-here"
# MODEL_NAME="gpt-4"

# ============================
# 代理配置（可选）
# ============================
# 如需使用代理，取消下面的注释
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# ============================
# 音画同步分析配置（可选 - 视频帧+语音联合分析）
# ============================
# 功能：本地抽取视频帧 + ASR语音识别 + 音画时间轴对齐
# 适用场景：深度分析视频内容结构，如产品出现时间、干货开始时间等

# 是否启用音画同步分析（默认关闭，需本地有ffmpeg）
# ENABLE_AV_SYNC="true"

# 是否启用帧+ASR联合分析（需先启用 ENABLE_AV_SYNC）
# 功能：将关键帧（带精确时间戳）+ 语音转录（带句粒度时间戳）组合发送给VL模型
# 优势：时间戳来自 ffmpeg/ASR，而非让模型"猜测"，精度更高
# 推荐配合 VIDEO_SOURCE_MODE="proxy" 使用
# ENABLE_FRAME_ASR_ANALYSIS="true"

# 帧+ASR分析配置
# FRAME_ASR_SAMPLE_STRATEGY="key"  # 采样策略：key=关键帧, all=全部, interval=固定间隔
# FRAME_ASR_MAX_FRAMES="5"         # 单次API调用最多帧数
# FRAME_ASR_API_DELAY="2.0"        # API调用间隔（秒）

# ASR语音识别使用通义千问ASR（需配置DashScope API）
# 模型：qwen3-asr-flash-filetrans（约0.014元/分钟）
# API Key 与 OPENAI_API_KEY 共用 DashScope 的 Key
DASHSCOPE_API_KEY="sk-your-dashscope-api-key"

# 帧抽取配置
# 抽帧间隔（秒），默认5秒抽一帧
FRAME_INTERVAL="5.0"
# 单个视频最大抽帧数，默认20帧
MAX_FRAMES_PER_VIDEO="20"

# 临时文件清理
# 分析完成后是否自动清理下载的视频和抽取的帧
CLEANUP_TEMP_FILES="true"

# ============================
# OCR 配置（封面文字识别）
# ============================
# OCR 模式选择
# - ai: 使用 AI 视觉模型（默认，需要配置多模态 API，约 0.01 元/张图）
# - disabled: 禁用 OCR 功能（封面颜色/布局分析仍正常工作）
OCR_MODE="ai"

# 说明：
# - AI OCR 使用已下载的图片转 base64 传给模型，避免防盗链问题
# - 需要先配置 MULTIMODAL_API_BASE、MULTIMODAL_API_KEY、MULTIMODAL_MODEL_NAME
# - 如未配置多模态 API，系统会自动禁用 OCR 功能

# ============================
# 其他配置
# ============================
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# 请求超时时间（秒）
REQUEST_TIMEOUT="30"

# 重试次数
MAX_RETRIES="3"

# ============================
# 阶段4 编排引擎
# ============================
# 控制任务编排走哪条引擎。阶段4.0 引入 LangGraph 作为企业级状态图
# simple:     默认，兼容自研线性编排 AgentOrchestrator（零破坏性变更）
# langgraph:  启用 LangGraph，用状态图驱动 8 Agent 编排
ORCHESTRATION_ENGINE="simple"