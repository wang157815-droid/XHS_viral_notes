# ============================
# Minimax Chat API ����
# ============================
# Minimax API Key���� minimax.chat ����̨��ȡ��
MINIMAX_API_KEY="your_minimax_api_key_here"
# Minimax API Base URL��Ĭ�Ϲٷ���ַ��������ʿ�����Ҫ������
MINIMAX_API_BASE="https://api.minimax.chat/v1"
# ʹ�õ�ģ������
MINIMAX_MODEL="abab6.5s-chat"
# ���λظ���� Token ��
